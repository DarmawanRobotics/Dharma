# Sensor driver and LiDAR-inertial odometry: vcs import src < external.repos
# Livox-SDK2 (needed by livox_ros_driver2) is installed by scripts/setup.sh install livox.
repositories:
  external/livox_ros_driver2:
    type: git
    url: https://github.com/JasonY85/livox_ros_driver2.git
    version: humble
  external/FAST_LIO:
    type: git
    url: https://github.com/hku-mars/FAST_LIO.git
    version: ROS2
  # Leg-KILO (odometry method leg_kilo), the DarmawanRobotics fork with ROS 2 support:
  # external/legkilo:
  #   type: git
  #   url: https://github.com/DarmawanRobotics/legkilo.git
  #   version: main
